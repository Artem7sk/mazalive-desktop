{
  "name": "mazlive-desktop",
  "version": "1.0.0",
  "description": "Mazlive Desktop — Streamer Game Launcher",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"electron .\"",
    "build": "tsc && electron-builder",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build-win": "tsc && electron-builder --win",
    "build-mac": "tsc && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.3",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^8.2.2",
    "electron": "31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.mazalive.desktop",
    "productName": "Mazlive",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "zip",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage"
    },
    "protocols": [
      {
        "name": "Mazlive Protocol",
        "schemes": [
          "mazalive"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true
  },
  "author": "Mazlive"
}
