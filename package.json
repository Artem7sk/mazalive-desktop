{
  "name": "mazlive-desktop",
  "version": "2.0.0-beta.10",
  "description": "Mazlive Desktop 2.0 Beta — Streamer Game Launcher (web-games + GTA «Царь горы»)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "test": "node --test test/bridge.test.mjs test/rules.test.mjs test/gta-agent.test.mjs",
    "dist": "npm run build && electron-builder",
    "build-win": "npm run build && electron-builder --win",
    "build-mac": "npm run build && electron-builder --mac"
  },
  "author": "Mazlive",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.20.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^20.14.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.mazlive.desktop",
    "productName": "Mazlive Desktop",
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "agent/**/*",
      "mod/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "agent",
        "to": "agent"
      },
      {
        "from": "mod",
        "to": "mod"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "zip"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "generic",
      "url": "https://mazlive.com/api/updates/beta/",
      "channel": "beta"
    }
  }
}
